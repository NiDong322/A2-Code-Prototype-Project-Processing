def setup():
    size(800, 600)
    background(135, 206, 235)   # 天蓝色背景

    # ---------- 草地 ----------
    noStroke()
    fill(110, 180, 90)
    rect(0, 430, 800, 170)

    # ---------- 太阳 ----------
    fill(255, 220, 70)
    ellipse(680, 100, 90, 90)

    # 太阳光线
    stroke(255, 200, 50)
    strokeWeight(4)
    line(680, 30, 680, 0)
    line(680, 170, 680, 200)
    line(610, 100, 580, 100)
    line(750, 100, 780, 100)
    line(630, 50, 610, 30)
    line(730, 50, 750, 30)
    line(630, 150, 610, 170)
    line(730, 150, 750, 170)

    # ---------- 白云 1 ----------
    noStroke()
    fill(255)
    ellipse(140, 120, 90, 55)
    ellipse(185, 105, 100, 70)
    ellipse(230, 120, 90, 55)

    # ---------- 白云 2 ----------
    ellipse(460, 150, 85, 50)
    ellipse(500, 135, 100, 65)
    ellipse(545, 150, 85, 50)

    # ---------- 树干 ----------
    fill(130, 85, 45)
    rect(350, 300, 80, 170)

    # 树干分支
    stroke(130, 85, 45)
    strokeWeight(18)
    line(370, 330, 320, 270)
    line(410, 330, 460, 270)

    # ---------- 树冠 ----------
    noStroke()
    fill(70, 150, 70)

    ellipse(300, 260, 170, 150)
    ellipse(380, 230, 190, 170)
    ellipse(460, 260, 170, 150)
    ellipse(340, 300, 180, 150)
    ellipse(430, 300, 180, 150)

    # ---------- 苹果 ----------
    fill(220, 50, 50)

    ellipse(320, 250, 32, 32)
    ellipse(370, 220, 32, 32)
    ellipse(430, 245, 32, 32)
    ellipse(470, 285, 32, 32)
    ellipse(350, 300, 32, 32)
    ellipse(410, 320, 32, 32)

    # 苹果梗
    stroke(90, 60, 30)
    strokeWeight(3)

    line(320, 236, 320, 226)
    line(370, 206, 370, 196)
    line(430, 231, 430, 221)
    line(470, 271, 470, 261)
    line(350, 286, 350, 276)
    line(410, 306, 410, 296)

    # ---------- 草地小细节 ----------
    stroke(70, 140, 60)
    strokeWeight(2)

    line(100, 520, 95, 500)
    line(100, 520, 110, 500)

    line(180, 550, 175, 530)
    line(180, 550, 190, 530)

    line(600, 520, 595, 500)
    line(600, 520, 610, 500)

    line(700, 560, 695, 540)
    line(700, 560, 710, 540)
    
